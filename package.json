{
  "name": "@robos/kie-mcp",
  "version": "0.1.0",
  "description": "MCP server for Kie.ai. Sync-wait, auto-download, batch compare, cost telemetry. Five umbrella tools (kie_image, kie_video, kie_music, kie_speech, kie_compare) dispatch across 30+ providers.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kie-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ulmeanuadrian/kie-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ulmeanuadrian/kie-mcp/issues"
  },
  "homepage": "https://github.com/ulmeanuadrian/kie-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "test": "jest --testPathPattern=tests",
    "eval": "jest --testPathPattern=evals --runInBand",
    "eval:live": "KIE_EVAL_LIVE=1 jest --testPathPattern=evals --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kie",
    "ai-media",
    "video-generation",
    "image-generation",
    "music-generation",
    "tts"
  ],
  "author": "Adrian Ulmeanu",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
